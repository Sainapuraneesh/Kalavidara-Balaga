<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KalavidaraBalaga" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/kb_saffron</item>
        <item name="colorPrimaryVariant">@color/kb_deep_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/kb_gold</item>
        <item name="colorOnSecondary">@color/kb_dark_text</item>
        <item name="colorOnSurface">@color/kb_dark_text</item>
        <item name="android:colorBackground">@color/kb_cream</item>
        <item name="android:textColor">@color/kb_dark_text</item>
        <item name="android:editTextColor">@color/kb_dark_text</item>
        <item name="android:statusBarColor">@color/kb_deep_red</item>
        <item name="android:navigationBarColor">@color/kb_deep_red</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.KalavidaraBalaga.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Chip style for equipment tags -->
    <style name="KbChipStyle" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/kb_cream</item>
        <item name="strokeColor">@color/kb_gold</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/kb_dark_text</item>
    </style>
</resources>
