<navigation
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:id="@+id/nav_graph"
app:startDestination="@id/homeFragment" >
<fragment
    android:id="@+id/homeFragment"
    android:name="com.kalavidarabalaga.ui.home.HomeFragment"
    android:label="Home" />
<fragment
    android:id="@+id/searchFragment"
    android:name="com.kalavidarabalaga.ui.search.SearchFragment"
    android:label="Search" />
<fragment
    android:id="@+id/myTroupeFragment"
    android:name="com.kalavidarabalaga.ui.troupeleader.MyTroupeFragment"
    android:label="My Troupe" >

    <action
        android:id="@+id/action_myTroupe_to_addEditTroupe"
        app:destination="@id/addEditTroupeFragment" />

</fragment>
<fragment
    android:id="@+id/addEditTroupeFragment"
    android:name="com.kalavidarabalaga.ui.troupeleader.AddEditTroupeFragment"
    android:label="Add / Edit Troupe" >

    <argument
        android:name="troupeId"
        android:defaultValue=""
        app:argType="string" />

</fragment>
</navigation>